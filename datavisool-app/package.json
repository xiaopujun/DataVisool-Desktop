{
  "license": "SEE LICENSE IN LICENSE",
  "name": "datavisool-app",
  "private": true,
  "version": "2026.10.0",
  "type": "module",
  "scripts": {
    "prepare:datavisool-ui": "pnpm -F @datavisool/ui build",
    "prepare:datavisool-interaction-engine": "pnpm -F @datavisool/interaction-engine build",
    "prepare:workspace": "pnpm -r --filter datavisool-app^... run build",
    "dev": "pnpm run prepare:workspace && vite --config vite.dev.config.ts",
    "dev:tauri": "pnpm run prepare:workspace && vite --config vite.dev.config.ts --port 5173",
    "build:local": "tsc && vite build --config vite.build.config.ts",
    "build": "pnpm run prepare:workspace && pnpm run build:local",
    "action:local": "vite build --config vite.build.config.ts",
    "action": "pnpm run prepare:workspace && pnpm run action:local",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check": "pnpm run prepare:workspace && tsc --noEmit --watch",
    "test": "pnpm run prepare:workspace && vitest run",
    "test:watch": "pnpm run prepare:workspace && vitest",
    "test:coverage": "pnpm run prepare:workspace && vitest run --coverage",
    "test:desktop": "node ./scripts/test-desktop.mjs",
    "test:all": "pnpm run prepare:workspace && pnpm exec tsc --noEmit && pnpm test",
    "sidecar:prepare": "node ./scripts/prepare-ripgrep-sidecars.mjs",
    "sidecar:verify": "node ./scripts/prepare-ripgrep-sidecars.mjs --verify",
    "tauri:icon": "tauri icon ./src-tauri/icons/icon-square.png",
    "tauri:dev": "tauri dev",
    "tauri:dev:debug": "RUST_LOG=debug tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:internal": "tauri build --features internal-devtools",
    "release:desktop": "node ./scripts/release-desktop.mjs",
    "release:desktop:internal": "node ./scripts/release-desktop.mjs --internal-devtools",
    "preview": "pnpm build && vite preview"
  },
  "dependencies": {
    "@antv/g-base": "^0.5.15",
    "@antv/g2plot": "^2.4.31",
    "@datavisool/interaction-engine": "workspace:^",
    "@datavisool/sdk": "workspace:^",
    "@datavisool/ui": "workspace:^",
    "@icon-park/react": "^1.4.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "acorn": "^8.15.0",
    "axios": "^1.13.2",
    "countup.js": "^2.8.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "echarts": "^5.5.1",
    "fflate": "^0.8.2",
    "flv.js": "^1.6.2",
    "hls.js": "^1.5.11",
    "hotkeys-js": "^3.13.15",
    "jsencrypt": "^3.3.2",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "maplibre-gl": "^5.16.0",
    "mobx": "^6.7.0",
    "mobx-react": "^7.6.0",
    "mqtt": "^5.10.1",
    "nprogress": "^0.2.0",
    "odometer_countup": "^1.0.4",
    "pixi.js": "^8.4.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-error-boundary": "^6.0.2",
    "react-router-dom": "^6.21.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@amap/amap-jsapi-types": "^0.0.15",
    "@tauri-apps/cli": "2.9.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.14.178",
    "@types/node": "^20.10.4",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@wdio/cli": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^28.1.0",
    "less": "^3.11.1",
    "react-refresh": "^0.8.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "tsx": "^4.22.4",
    "typescript": "^5.0.2",
    "vite": "^5.0.7",
    "vitest": "^4.0.18",
    "webdriverio": "^9.33.1"
  }
}
