# Copy this file to .env.release and fill in your real values.
# The release script is intended to run on a Mac host and will build:
# - darwin-aarch64
# - darwin-x86_64
# - windows-x86_64

# Optional macOS bundle override. Default is app,dmg.
# If you need to avoid DMG creation in a
# restricted environment, change it to app.
# DATAVISOOL_MAC_BUNDLES=app,dmg

# Optional target override for debugging only.
# DATAVISOOL_RELEASE_TARGETS=darwin-aarch64,darwin-x86_64,windows-x86_64

# Optional internal build switch. When enabled, the packaged app will open
# Tauri DevTools on startup. Keep this for internal QA builds only.
# DATAVISOOL_INTERNAL_DEVTOOLS=1

# macOS app code signing identity. It must exactly match one line from:
# security find-identity -v -p codesigning
# For public distribution, use a Developer ID Application identity.
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)

# If you inject a signing certificate from CI instead of using the local
# keychain, set both of the following.
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=

# macOS notarization credentials.
# Recommended option A: App Store Connect API key (all three required)
# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_API_KEY=ABC123DEFG
# APPLE_API_KEY_PATH=$HOME/private_keys/AuthKey_ABC123DEFG.p8
#
# Fallback option B: Apple ID + app-specific password (all three required)
# APPLE_ID=your-apple-id@example.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=YOURTEAMID
